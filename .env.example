# Copy this file to .env and adjust the values.

# Web server
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medibook
DB_USER=medibook
DB_PASSWORD=change_me
# Clinic time zone as a UTC offset; used by MySQL sessions and the app.
DB_TIMEZONE=+02:00
DB_ROOT_PASSWORD=change_me_root

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
